    "build": "tsc && node -e \"const fs=require('node:fs'); fs.cpSync('src/locales','dist/locales',{recursive:true}); fs.cpSync('src/modules/agent/apps/operations/skills','dist/modules/agent/apps/operations/skills',{recursive:true}); fs.cpSync('src/infrastructure/agent/plugins/frontend-sdk','dist/infrastructure/agent/plugins/frontend-sdk',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
