{
  "name": "@nexus-terminal/backend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm --filter @nexus-terminal/shared build && tsc --noEmit",
    "build": "pnpm --filter @nexus-terminal/shared build && tsc",
    "test": "pnpm run build && node --test --test-concurrency=1 --test-timeout=60000 ../../tests/backend/storage/backend-next*.integration.mjs ../../tests/backend/http/backend-next*.integration.mjs ../../tests/backend/remote/backend-next*.integration.mjs",
    "test:natural-access": "pnpm run build && node ../../tests/backend/http/access-natural-expiry.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@nexus-terminal/shared": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "archiver": "^8.0.0",
    "fast-xml-parser": "5.11.2",
    "file-type": "22.2.0",
    "formidable": "3.5.4",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openai": "7.43.0",
    "otplib": "13.5.0",
    "p-retry": "^8.0.1",
    "pino": "catalog:",
    "proxy-addr": "^2.0.7",
    "puppeteer-core": "catalog:",
    "qrcode": "^1.5.4",
    "semver": "7.8.5",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "undici": "^7.30.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/formidable": "^3.5.1",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:node-build"
  }
}
