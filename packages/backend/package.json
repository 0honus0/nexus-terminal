    "archiver": "^8.0.0",
    "axios": "catalog:",
    "bcrypt": "^6.0.0",
    "content-disposition": "^3.0.0",
    "dotenv": "^17.4.2",
    "eventsource-parser": "^4.1.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "guacamole-lite": "1.2.0",
    "i18next": "^26.4.2",
    "iconv-lite": "^0.7.3",
