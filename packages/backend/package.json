{
  "name": "@nexus-terminal/backend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm --filter @nexus-terminal/shared build && tsc --noEmit",
    "build": "pnpm --filter @nexus-terminal/shared build && tsc",
    "test": "pnpm run build && node --test --test-concurrency=1 --test-timeout=60000 ../../tests/backend/storage/backend-next*.integration.mjs ../../tests/backend/http/backend-next*.integration.mjs ../../tests/backend/remote/backend-next*.integration.mjs",
    "test:natural-access": "pnpm run build && node ../../tests/backend/http/access-natural-expiry.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@nexus-terminal/shared": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "archiver": "^8.0.0",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.0.14",
    "pino": "catalog:",
    "proxy-addr": "^2.0.7",
    "puppeteer-core": "catalog:",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "undici": "^7.29.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:node-build"
  }
}
