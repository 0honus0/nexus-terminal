{
  "name": "@nexus-terminal/backend",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "bcrypt": true,
    "ssh2": true
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/locales', 'dist/locales', { recursive: true })\"",
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "guacamole-lite": "1.2.0",
    "i18next": "^26.4.2",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "jschardet": "^3.1.4",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "session-file-store": "^1.5.0",
    "socks": "^2.8.10",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/session-file-store": "^1.2.6",
    "@types/speakeasy": "^2.0.10",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
