{
  "name": "@nexus-terminal/backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm --filter @nexus-terminal/shared build && tsc --noEmit",
    "build": "pnpm --filter @nexus-terminal/shared build && node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\" && tsc && node build/build-plugin-backend-sdk.mjs && node build/copy-plugin-frontend-sdk.mjs",
    "test": "pnpm --dir ../.. run build:backend && node --test --test-concurrency=1 --test-timeout=60000 ../../tests/backend/storage/backend-next*.integration.mjs ../../tests/backend/http/backend-next*.integration.mjs ../../tests/backend/remote/backend-next*.integration.mjs",
    "test:natural-access": "pnpm --dir ../.. run build:backend && node ../../tests/backend/http/access-natural-expiry.mjs",
    "start": "node dist/main.js",
    "build:plugin-sdk": "pnpm --filter @nexus-terminal/shared build && node build/build-plugin-backend-sdk.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@nexus-terminal/shared": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ajv": "8.20.0",
    "archiver": "^8.0.0",
    "fast-xml-parser": "5.12.0",
    "fastify": "5.12.8",
    "file-type": "22.3.0",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.3.1",
    "openai": "7.51.0",
    "openid-client": "6.8.9",
    "otplib": "13.6.0",
    "p-limit": "7.3.3",
    "p-retry": "^9.0.0",
    "pino": "catalog:",
    "proxy-addr": "^2.0.8",
    "puppeteer-core": "catalog:",
    "qrcode": "^1.5.4",
    "semver": "7.8.6",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "undici": "^8.12.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "typescript": "catalog:node-build",
    "esbuild": "0.28.2"
  }
}
