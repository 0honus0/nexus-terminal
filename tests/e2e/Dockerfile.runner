ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-bookworm-slim

ARG E2E_RUNNER_FINGERPRINT
ARG PLAYWRIGHT_VERSION
ARG PNPM_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    COREPACK_HOME=/opt/corepack \
    PNPM_HOME=/opt/pnpm \
    PNPM_STORE_DIR=/opt/pnpm/store \
    XDG_CACHE_HOME=/opt/pnpm/cache \
    npm_config_nodedir=/usr/local \
    E2E_RUNNER_FINGERPRINT=${E2E_RUNNER_FINGERPRINT} \
    PATH=/opt/pnpm:/opt/corepack:${PATH}

RUN corepack enable \
  && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
  && pnpm config set store-dir "${PNPM_STORE_DIR}" \
  && pnpm dlx "playwright@${PLAYWRIGHT_VERSION}" install --with-deps --only-shell chromium \
  && apt-get update \
  && apt-get install -y --no-install-recommends bzip2 ca-certificates git openssh-client unzip zip \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /root/.cache

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/backend/package.json packages/backend/package.json
COPY packages/frontend/package.json packages/frontend/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY tests/e2e/package.json tests/e2e/package.json
RUN pnpm fetch --frozen-lockfile --ignore-scripts
