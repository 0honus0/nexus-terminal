{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../packages/frontend/src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts", "../packages/frontend/src/**/*.d.ts"],
  "exclude": ["node_modules", "e2e/fixtures/agent/plugin-source"]
}
