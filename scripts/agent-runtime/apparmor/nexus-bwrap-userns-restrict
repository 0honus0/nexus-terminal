# Nexus-owned variant of AppArmor's bwrap-userns-restrict profile.
# It is intentionally scoped to the SHA-256-pinned bubblewrap binary installed by
# scripts/agent-runtime/prepare-ubuntu-host.sh. Bubblewrap may construct namespaces;
# payloads are stacked with nexus_unpriv_bwrap so they cannot retain capabilities.

abi <abi/4.0>,

include <tunables/global>

profile nexus_bwrap /usr/local/lib/nexus-agent-runner/bubblewrap/0.12.0/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Stack every payload with the capability-stripping child profile. This mirrors
  # upstream AppArmor's bwrap-userns-restrict policy while keeping the grant scoped
  # to the Nexus-owned executable path rather than all bubblewrap installations.
  allow pix /** -> &nexus_bwrap//&nexus_unpriv_bwrap,
}

profile nexus_unpriv_bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  allow pix /** -> &nexus_unpriv_bwrap,
  audit deny capability,
}
