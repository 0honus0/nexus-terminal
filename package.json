{
  "name": "nexus-terminal",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter @nexus-terminal/backend build",
    "build:frontend": "pnpm --filter @nexus-terminal/frontend build",
    "docker:build": "scripts/build/build.sh docker",
    "docker:save": "scripts/build/build.sh docker-save",
    "test:e2e:env:latest": "node scripts/e2e/update-latest-test-environment.mjs",
    "test:e2e:env:sync": "node scripts/e2e/sync-test-environment.mjs",
    "test:e2e:runner:build": "bash scripts/e2e/build-runner-image.sh",
    "test:e2e:seed": "pnpm --filter @nexus-terminal/e2e seed:refresh",
    "test:e2e:groups:generate": "pnpm --filter @nexus-terminal/e2e groups:generate",
    "test:e2e:groups:check": "pnpm --filter @nexus-terminal/e2e groups:check",
    "test:e2e:groups:matrix": "pnpm --filter @nexus-terminal/e2e groups:matrix",
    "test:e2e:group": "pnpm --filter @nexus-terminal/e2e groups:run",
    "test:e2e:groups:update-timings": "pnpm --filter @nexus-terminal/e2e groups:update-timings",
    "test:e2e": "pnpm --filter @nexus-terminal/e2e test",
    "test:e2e:auth": "pnpm --filter @nexus-terminal/e2e test:auth",
    "test:e2e:http": "pnpm --filter @nexus-terminal/e2e test:http",
    "test:e2e:agent": "pnpm --filter @nexus-terminal/e2e test:agent",
    "test:e2e:websocket": "pnpm --filter @nexus-terminal/e2e test:websocket",
    "test:e2e:ui": "pnpm --filter @nexus-terminal/e2e test:ui",
    "test:e2e:ssh": "pnpm --filter @nexus-terminal/e2e test:ssh",
    "test:e2e:mobile": "pnpm --filter @nexus-terminal/e2e test:mobile",
    "test:e2e:list": "pnpm --filter @nexus-terminal/e2e test:list",
    "format": "node scripts/format-changed.mjs --write",
    "format:check": "node scripts/format-changed.mjs --check",
    "format:all": "prettier --write \"{packages,tests,scripts,doc,.github}/**/*.{ts,tsx,js,mjs,cjs,json,css,md,vue,yml,yaml}\" \"package.json\"",
    "format:all:check": "prettier --check \"{packages,tests,scripts,doc,.github}/**/*.{ts,tsx,js,mjs,cjs,json,css,md,vue,yml,yaml}\" \"package.json\"",
    "build:agent-runner": "pnpm --filter @nexus-terminal/agent-runner build",
    "perf:database-runtime": "pnpm --filter @nexus-terminal/backend exec tsx ../../scripts/backend/perf/database-runtime-benchmark.ts",
    "agent:model-registry:sync": "pnpm --filter @nexus-terminal/backend exec tsx tools/sync-model-capability-registry.ts",
    "lint": "corepack pnpm run lint:transport-contracts && corepack pnpm run lint:frontend-boundaries && corepack pnpm run lint:frontend-state-lifecycles && corepack pnpm run lint:agent-i18n && corepack pnpm run lint:frontend && corepack pnpm run lint:agent",
    "lint:transport-contracts": "node scripts/check-transport-contract-boundaries.mjs",
    "lint:frontend-boundaries": "node scripts/check-frontend-public-boundaries.mjs && node --test tests/frontend-public-boundaries.test.mjs",
    "lint:frontend-state-lifecycles": "node scripts/check-frontend-state-lifecycles.mjs",
    "lint:agent-i18n": "node scripts/check-agent-i18n.mjs",
    "lint:frontend": "eslint packages/frontend/src",
    "lint:agent": "eslint packages/backend/src/modules/agent packages/backend/src/infrastructure/agent packages/backend/src/interfaces/http/agent packages/backend/src/interfaces/websocket/agent*.ts packages/agent-runner/src tests/backend/agent-scenarios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0honus0/nexus-terminal.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/0honus0/nexus-terminal/issues"
  },
  "homepage": "https://github.com/0honus0/nexus-terminal#readme",
  "description": "Unified build entry points for Nexus Terminal",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  }
}
