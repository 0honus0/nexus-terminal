{
  "name": "nexus-terminal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "exports": {
    "./node": "./src/sdk/node/index.ts",
    "./browser": "./src/sdk/browser/index.ts",
    "./browser/ui": "./src/sdk/browser/ui-api.ts"
  },
  "scripts": {
    "start:backend": "tsx src/app/node/main.ts",
    "start:frontend": "vite",
    "build:frontend": "vite build",
    "build:sdk": "node scripts/sdk/build.mjs",
    "pack:sdk": "pnpm build:sdk && pnpm --dir dist/sdk pack --pack-destination ..",
    "preview:frontend": "vite preview",
    "test:sdk": "pnpm pack:sdk && tsx --test tests/integration/sdk/sdk-delivery.test.ts",
    "test:backend": "tsx --test \"tests/integration/backend/*.test.ts\"",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:component": "vitest run --config tests/vitest.config.ts",
    "test:browser": "node --import tsx node_modules/@playwright/test/cli.js test --config tests/playwright.config.ts",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tests/tsconfig.json",
    "format": "nexus-format .",
    "format:check": "nexus-format --check .",
    "check": "pnpm typecheck && pnpm format:check"
  },
  "dependencies": {
    "@dagrejs/graphlib": "^4.0.7",
    "detect-libc": "^2.1.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "express-zod-api": "^30.0.4",
    "fast-json-patch": "^3.1.1",
    "kysely": "^0.29.9",
    "kysely-generic-sqlite": "^2.0.1",
    "mime-types": "^3.0.2",
    "neverthrow": "^8.2.0",
    "npm-install-checks": "^9.0.0",
    "p-limit": "^7.3.3",
    "p-timeout": "^8.1.0",
    "pacote": "^22.0.1",
    "pino": "^10.4.0",
    "scrypt-kdf": "^4.0.0",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "validate-npm-package-name": "^7.0.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@1adybug/mi-sans": "^0.1.2",
    "@lucide/vue": "1.72.0",
    "@nexus-terminal/format": "file:scripts/format",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/pacote": "^11.1.8",
    "@types/semver": "^7.8.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.5.1",
    "@vueuse/core": "^15.0.0",
    "gridstack": "14.1.0",
    "hookable": "5.5.3",
    "interactjs": "^1.10.28",
    "jsdom": "31.0.0",
    "motion-v": "2.12.0",
    "reka-ui": "^2.11.0",
    "rollup": "^4.68.5",
    "rollup-plugin-dts": "^6.5.1",
    "tar": "^7.5.23",
    "typescript": "~6.0.3",
    "uuid": "^14.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-tsc": "^3.3.14"
  }
}
