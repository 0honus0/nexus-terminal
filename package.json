{
  "name": "nexus-terminal",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter @nexus-terminal/backend build",
    "build:frontend": "pnpm --filter @nexus-terminal/frontend build",
    "docker:build": "scripts/build/build.sh docker",
    "docker:save": "scripts/build/build.sh docker-save",
    "test:e2e": "pnpm --filter @nexus-terminal/e2e test",
    "test:e2e:remote": "node scripts/e2e/run-remote.mjs",
    "test:e2e:auth": "pnpm --filter @nexus-terminal/e2e test:auth",
    "test:e2e:http": "pnpm --filter @nexus-terminal/e2e test:http",
    "test:e2e:agent": "pnpm --filter @nexus-terminal/e2e test:agent",
    "test:e2e:websocket": "pnpm --filter @nexus-terminal/e2e test:websocket",
    "test:e2e:ui": "pnpm --filter @nexus-terminal/e2e test:ui",
    "test:e2e:ssh": "pnpm --filter @nexus-terminal/e2e test:ssh",
    "test:e2e:mobile": "pnpm --filter @nexus-terminal/e2e test:mobile",
    "test:e2e:list": "pnpm --filter @nexus-terminal/e2e test:list",
    "format": "pnpm run format:spacing && node scripts/format/changed.mjs --write",
    "format:check": "pnpm run format:spacing:check && node scripts/format/changed.mjs --check",
    "format:spacing": "eslint --fix packages/backend/src packages/shared/src packages/frontend/src tests scripts eslint.config.mjs",
    "format:spacing:check": "eslint packages/backend/src packages/shared/src packages/frontend/src tests scripts eslint.config.mjs",
    "format:all": "pnpm run format:spacing && prettier --write \"{packages,tests,scripts,doc,.github}/**/*.{ts,tsx,js,mjs,cjs,json,css,md,vue,yml,yaml}\" package.json eslint.config.mjs",
    "format:all:check": "pnpm run format:spacing:check && prettier --check \"{packages,tests,scripts,doc,.github}/**/*.{ts,tsx,js,mjs,cjs,json,css,md,vue,yml,yaml}\" package.json eslint.config.mjs",
    "check": "node scripts/checks/run-all.mjs",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "eslint packages/frontend/src",
    "test:frontend-auth": "pnpm --filter @nexus-terminal/backend build && node tests/frontend/auth.integration.mjs",
    "test:frontend-targets": "pnpm --filter @nexus-terminal/backend build && node tests/frontend/targets.integration.mjs",
    "test:backend": "pnpm --filter @nexus-terminal/backend test",
    "lint:backend": "eslint packages/backend/src",
    "test:e2e:backend": "pnpm --filter @nexus-terminal/e2e test:backend",
    "test:e2e:browser": "pnpm --filter @nexus-terminal/e2e test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0honus0/nexus-terminal.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/0honus0/nexus-terminal/issues"
  },
  "homepage": "https://github.com/0honus0/nexus-terminal#readme",
  "description": "Unified build entry points for Nexus Terminal",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.28.9"
}
