{
  "name": "@nexus-terminal/e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "seed:refresh": "npm exec --prefix ../../packages/backend tsx -- ../../test/e2e/support/create-seed.ts",
    "groups:generate": "node support/groups.mjs generate",
    "groups:check": "node support/groups.mjs check",
    "groups:matrix": "node support/groups.mjs matrix",
    "groups:run": "node support/groups.mjs run",
    "groups:update-timings": "node support/groups.mjs update-timings",
    "test": "playwright test",
    "test:auth": "playwright test --project=auth",
    "test:http": "playwright test --project=http",
    "test:websocket": "playwright test --project=websocket",
    "test:ui": "playwright test --project=ui",
    "test:ssh": "playwright test --project=ssh",
    "test:mobile": "playwright test --project=mobile",
    "test:docs": "node support/run-functional-screenshots.mjs",
    "test:ingress": "playwright test --config=playwright.ingress.config.ts",
    "test:list": "playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
