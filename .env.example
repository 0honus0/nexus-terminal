# Docker image and published HTTP port.
NEXUS_IMAGE_REPOSITORY=ghcr.io/0honus0/nexus-terminal
NEXUS_IMAGE_TAG=latest
NEXUS_HTTP_PORT=18111

# Remote desktop runtime image. Backend reaches the internal guacd service at guacd:4822.
GUACD_IMAGE=guacamole/guacd:latest

# Docker network. Change these only when they conflict with an existing subnet.
NEXUS_IPV6_SUBNET=fd01::/80
NEXUS_IPV6_GATEWAY=fd01::1

# Application display name. Additional custom backend variables may also be added here.
APP_NAME=Nexus Terminal

# Optional Agent execution plane. The core product runs without the `agent` Compose profile.
# To enable it, generate a high-entropy shared Controller token (at least 32 characters),
# for example: openssl rand -hex 32
# The profile grants SYS_ADMIN + NET_ADMIN only to the top-level Runner container so
# bubblewrap can construct namespace/mount boundaries and initialize the isolated loopback;
# it does not use privileged mode or expose a Docker socket, and sandbox payloads drop all
# Linux capabilities before execution.
# Then start with: docker compose --profile agent up -d
NEXUS_AGENT_RUNNER_TOKEN=
NEXUS_AGENT_DEPLOYMENT_ID=nexus-local
# NEXUS_AGENT_RUNNER_IMAGE=nexus-agent-runner:local

# Passkey.
# Single domain: RP_ID="yourdomain.com", RP_ORIGIN="https://yourdomain.com"
# Independent domains: pair comma-separated RP_ID and RP_ORIGIN values by position.
# Related origins: use one RP_ID and multiple comma-separated RP_ORIGIN values.
RP_ID="yourdomain.com"
RP_ORIGIN="https://yourdomain.com"

# ENCRYPTION_KEY and SESSION_SECRET are generated on first startup and stored
# in ./data/.env. Back up that file together with the rest of ./data.
