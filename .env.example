# Nexus Terminal 主镜像与对外 HTTP 端口。
NEXUS_IMAGE_REPOSITORY=ghcr.io/0honus0/nexus-terminal
NEXUS_IMAGE_TAG=latest
NEXUS_HTTP_PORT=18111
NEXUS_PUBLIC_ORIGIN=http://localhost:18111
NEXUS_PLUGIN_FRONTEND_PORT=18112
NEXUS_PLUGIN_FRONTEND_ORIGIN=http://localhost:18112

# -----------------------------------------------------------------------------
# Agent 官方插件目录。
# Nexus 主镜像不再编译/内置 nexus.operations；首次开启 Agent 时会提示安装 Operations Plugin，
# 然后从此目录下载签名包并通过 Host 内置的 Nexus 官方 Ed25519 公钥验签。
# 可以把 URL 改成你自己的 GitHub/CDN/反向代理镜像，但镜像内容必须保持官方签名；
# 官方 Publisher 公钥刻意不作为普通 .env 变量暴露，避免通过部署配置替换信任根。
NEXUS_AGENT_OFFICIAL_PLUGIN_CATALOG_URL=https://github.com/0honus0/nexus-agent-plugins/releases/latest/download/catalog.json

# 远程桌面运行时镜像。Backend 在 Compose 内通过 guacd:4822 访问。
GUACD_IMAGE=guacamole/guacd:latest

# Docker 网络。只有与宿主现有网段冲突时才需要修改。
NEXUS_IPV6_SUBNET=fd01::/80
NEXUS_IPV6_GATEWAY=fd01::1

# 应用显示名称。其他 Backend 自定义运行时变量也可以继续追加到本文件。
APP_NAME=Nexus Terminal

# -----------------------------------------------------------------------------
# Agent Runner：Nexus 当前是单用户应用，Runner 管理多个持久 Workspace 与共享运行环境。
# Workspace 是逻辑工作目录/运行环境边界，不是多租户安全沙箱；Runner 不创建 per-Workspace namespace。
# Token 至少 32 字符，建议使用 `openssl rand -hex 32` 生成。
NEXUS_AGENT_RUNNER_TOKEN=

# Backend 默认连接宿主机 Runner；宿主 Ubuntu/Debian 首次启用可执行：
#   ./scripts/agent-runner/prepare-ubuntu-host.sh
# 该脚本只安装固定版本 mise、Tool Pack 解包工具以及 script/stty 终端依赖，不编译 native helper。
NEXUS_AGENT_RUNNER_URL=http://host.docker.internal:8790

# 如果改用 docker-compose.yml 中默认注释掉的 agent-runner 容器服务：
# 1. 取消 Compose 中 agent-runner 整段注释；
# 2. 将上一行改成 NEXUS_AGENT_RUNNER_URL=http://agent-runner:8790；
# 3. 取消 Backend 对 agent-runner 的 depends_on 注释。
# 独立 Runner 镜像不需要 privileged / SYS_ADMIN / unconfined security profile / Docker socket。
# 独立 Runner 镜像与 Nexus Terminal 主镜像使用相同的 latest/dev/版本 tag 规则。
NEXUS_AGENT_RUNNER_IMAGE_REPOSITORY=ghcr.io/0honus0/nexus-agent-runner
NEXUS_AGENT_RUNNER_IMAGE_TAG=latest
NEXUS_AGENT_RUNNER_DATA_DIR=./agent-runner-data


# Passkey / WebAuthn。
# 单域名：RP_ID="yourdomain.com", RP_ORIGIN="https://yourdomain.com"
# 独立域名：RP_ID 与 RP_ORIGIN 按位置使用逗号分隔。
# Related Origins：一个 RP_ID 可以对应多个逗号分隔的 RP_ORIGIN。
RP_ID="yourdomain.com"
RP_ORIGIN="https://yourdomain.com"

# ENCRYPTION_KEY 与 SESSION_SECRET 首次启动时自动生成并保存在 ./data/.env。
# 备份时请把 ./data/.env 与整个 ./data 数据目录一起备份。
