# Shared frontend/backend image and public entry.
NEXUS_IMAGE_REPOSITORY=ghcr.io/0honus0/nexus-terminal
NEXUS_IMAGE_TAG=latest
NEXUS_HTTP_PORT=18111
NEXUS_PUBLIC_ORIGIN=http://localhost:18111
NEXUS_DATA_DIR=./data

# Required persistent instance key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Save the result before first startup. Back up this key together with ./data.
NEXUS_ENCRYPTION_KEY=

# Backend is private; Compose always trusts loopback for its health probe.
# Additional proxies must be on this isolated Compose network.
# For a host deployment use loopback or exact proxy IP/CIDR values.
NEXUS_TRUSTED_PROXIES=uniquelocal
NEXUS_IPV6_SUBNET=fd01::/80
NEXUS_IPV6_GATEWAY=fd01::1

# Initial Passkey sites default to NEXUS_PUBLIC_ORIGIN's origin/hostname.
# Multiple sites (JSON): [{"origin":"https://terminal.example.com","rpId":"example.com"}]
# NEXUS_PASSKEY_SITES=
# Initial CAPTCHA/security settings are subsequently managed in the Settings UI.

# OIDC: supplying issuer/client ID/secret enables it automatically at startup.
# The same values preserve existing OIDC sessions; changed values revoke them.
# Register ${NEXUS_PUBLIC_ORIGIN}/login/oidc/callback with your provider.
# NEXUS_OIDC_ISSUER=https://id.example.com
# NEXUS_OIDC_CLIENT_ID=nexus-terminal
# NEXUS_OIDC_CLIENT_SECRET='replace-with-provider-secret'
# NEXUS_OIDC_CLIENT_AUTHENTICATION=client_secret_basic
# NEXUS_OIDC_LABEL=Pocket ID
# Optional exact provider sub for your existing administrator. Without it,
# bind once in Settings > Security after logging in with the local account.
# NEXUS_OIDC_SUBJECT=
# For a public PKCE client, set authentication=none and omit client secret.
